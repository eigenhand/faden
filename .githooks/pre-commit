#!/bin/bash
# Verhindert, dass ein API-Schluessel in die Historie geraet.
#
# Liegt versioniert im Repo, nicht in .git/hooks — ein Haken dort wandert bei
# keinem Klonen mit, also haette ihn weder ein Mitwirkender noch man selbst nach
# dem naechsten Klonen. Scharf wird er mit:
#
#     git config core.hooksPath .githooks
#
# Frueher setzte release.sh einen Beta-Schluessel in BundledSetup.swift ein und
# raeumte per trap wieder auf; brach das Skript dazwischen ab, stand der Schluessel
# im Arbeitsverzeichnis. Diesen Weg gibt es nicht mehr — die App bringt keinen
# Anbieter mehr mit, jeder Schluessel gehoert dem Nutzer und liegt im Schluesselbund
# des Geraets. Der Haken bleibt trotzdem: aus der Historie bekommt man einen
# Schluessel nicht mehr heraus, und ein Test, der einen einmal hineinschreibt,
# kostet nichts ausser diesem Griff.
if git diff --cached -U0 | grep -qE '^\+.*(sk-[A-Za-z0-9]{16,}|BSA[A-Za-z0-9]{24,})'; then
  echo "ABBRUCH: Die Aenderung enthaelt etwas, das nach einem API-Schluessel aussieht." >&2
  exit 1
fi
