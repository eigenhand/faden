    "Antworten werden nur geschrieben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers are written, not spoken."
          }
        }
      }
    },
    "Apple lädt das Modell im Hintergrund. Einen Fortschritt meldet das System dabei nicht — du kannst die App in der Zwischenzeit benutzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple downloads the model in the background. The system reports no progress while it does — you can keep using the app meanwhile."
          }
        }
      }
    },
    "Apples Spracherkennung, wo möglich auf dem Gerät — dann verlässt nichts das iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's speech recognition, on the device where possible — then nothing leaves the iPhone."
          }
        }
      }
    },
