    "$%@/$%@ pro M": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "$%@/$%@ per M"
          }
        }
      }
    },
    "%@\n\nFaden kann den Endpoint selbst abklopfen, sich die Antwort ansehen und den Parser von einem deiner Modelle ableiten lassen. Der fertige Parser läuft danach lokal auf diesem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nFaden can probe the endpoint itself, look at the answer and have one of your models derive the parser. The finished parser then runs locally on this device."
          }
        }
      }
    },
