            "value": "Copy the paragraph"
          }
        }
      }
    },
    "Adresse und Format kommen aus der Vorlage. Den Schlüssel trägst du selbst ein — er liegt im Schlüsselbund des Geräts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address and format come from the template. You enter the key yourself — it is kept in the device's keychain."
          }
        }
      }
    },
    "Aktiv": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active"
          }
        }
      }
    },
    "Aktivieren": {
      "extractionState": "manual",
