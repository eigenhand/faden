    "API-Key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        }
      }
    },
    "Ablauf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sequence"
          }
        }
      }
    },
    "Aktiv": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active"
          }
        }
      }
    },
    "Aktivieren": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate"
          }
        }
      }
    },
    "Alle Vektoren werden verworfen und über deinen Endpoint neu geholt. Das kostet %@ Einbettungen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every vector is discarded and fetched again through your endpoint. That costs %@ embeddings."
          }
        }
      }
    },
    "Alles Gemerkte steht eine Ebene zurück unter „Gespeicherte Gedanken“ — dort einzeln nachlesen und löschen. Der Graph liegt als Datei auf diesem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything remembered sits one level back under “Saved thoughts” — read or delete them one by one there. The graph is a file on this device."
          }
        }
      }
    },
    "Anbieter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Providers"
          }
        }
      }
    },
    "Anbieter entfernen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove provider"
          }
        }
      }
    },
    "Anbieter hinzufügen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add provider"
          }
        }
      }
    },
    "Anrede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form of address"
          }
        }
      }
    },
    "Anthropic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic"
          }
        }
      }
    },
    "Antwort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer"
          }
        }
      }
    },
    "Antwort stoppen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the answer"
          }
        }
      }
    },
    "Antworten vorlesen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read answers aloud"
          }
        }
      }
    },
    "Antworten werden nur geschrieben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers are written, not spoken."
          }
        }
      }
    },
    "Apple lädt das Modell im Hintergrund. Einen Fortschritt meldet das System dabei nicht — du kannst die App in der Zwischenzeit benutzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple downloads the model in the background. The system reports no progress while it does — you can keep using the app meanwhile."
          }
        }
      }
    },
    "Apples Spracherkennung, wo möglich auf dem Gerät — dann verlässt nichts das iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's speech recognition, on the device where possible — then nothing leaves the iPhone."
          }
        }
      }
    },
    "Auf dem Gerät": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On device"
          }
        }
      }
    },
    "Aus anderer Herkunft: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From a different source: %@"
          }
        }
      }
    },
