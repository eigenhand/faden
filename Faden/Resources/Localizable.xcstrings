      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No images: %@"
          }
        }
      }
    },
    "Keine Frage in der Unterhaltung gefunden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No question found in the conversation."
          }
        }
      }
    },
