    "Keine Werkzeuge: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tools: %@"
          }
        }
      }
    },
    "Keine Werkzeuge: keine Websuche, kein Gedächtnisabruf, keine Dateien.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tools: no web search, no memory recall, no files."
          }
        }
      }
    },
    "Keine der ausprobierten Anfragevarianten kam mit HTTP 200 und einer JSON-Antwort zurück. Prüfe URL und Key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of the request variants tried came back with HTTP 200 and a JSON answer. Check the URL and key."
          }
        }
      }
    },
    "Key des Anbieters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider's key"
          }
        }
      }
    },
    "Keys liegen im Schlüsselbund dieses Geräts. Der Verlauf bleibt lokal. Faden spricht ausschließlich mit den Endpoints, die du hier einträgst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys live in this device's keychain. The history stays local. Faden speaks only to the endpoints you enter here."
          }
        }
      }
    },
    "Kleines Kontextfenster; lange Unterhaltungen brechen früher ab.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small context window; long conversations break off sooner."
          }
        }
      }
    },
