    "Apples Modell hat die Antwort verweigert. Die Sperren sitzen im System und lassen sich von hier nicht abschalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model refused to answer. The guardrails sit in the system and cannot be switched off from here."
          }
        }
      }
    },
    "Apples Modell kennt keine Werkzeuge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's model has no tools."
          }
        }
      }
    },
    "Apples Sicherheitsprüfung ist auf diesem System nicht verfügbar — im Simulator fehlt sie immer. Auf einem echten iPhone mit eingeschalteter Apple Intelligence läuft es.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's safety check is not available on this system — the simulator never has it. It works on a real iPhone with Apple Intelligence turned on."
          }
        }
      }
    },
