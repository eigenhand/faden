            "value": "%@ usable, %@ foreign, %@ open"
          }
        }
      }
    },
    "%@ warten auf Einbettung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ waiting to be embedded"
          }
        }
      }
    },
