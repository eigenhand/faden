<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No tracking, no tracking domains: Faden has no server and no analytics.
	     Requests go only to the endpoints the user sets up. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- The developer collects nothing. What goes to the user's own providers is
	     disclosed in the app and agreed to per provider before anything is sent. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- File timestamps (contentModificationDate):
		     C617.1 - the Fundus inventory in the shared App Group container, re-read
		              only when its modification date changes.
		     3B52.1 - files in the folder the user picked and granted access to: the
		              document index uses them to notice changed files, and the folder
		              listing shows them. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
