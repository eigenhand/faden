# Kopiere diese Datei nach .release.env und trage deine Werte ein.
# Beide Dateien stehen in .gitignore.
#
# Zu finden in App Store Connect:
#   Users and Access > Integrations > App Store Connect API
#   Die Issuer ID steht als UUID über der Key-Liste.
ASC_ISSUER_ID=

# Die Key ID steht in derselben Liste und ist Teil des Dateinamens des privaten
# Schlüssels: ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
#ASC_KEY_ID=XXXXXXXXXX
