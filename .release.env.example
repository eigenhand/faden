# Copy this file to .release.env and fill in your own values.
# Both files are in .gitignore.
#
# Where to find them in App Store Connect:
#   Users and Access > Integrations > App Store Connect API
#   The issuer ID stands as a UUID above the key list.
ASC_ISSUER_ID=

# The key ID stands in the same list and is part of the file name of the
# private key: ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
#ASC_KEY_ID=XXXXXXXXXX
